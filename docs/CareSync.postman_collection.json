{
  "info": {
    "name": "CareSync",
    "description": "Collection de testes para o Tech Challenge Fase 3 - CareSync. Cobre autenticacao por perfil (medico, enfermeiro, paciente), CRUD de consultas via REST, consultas via GraphQL, e cenarios de bloqueio de permissao (403).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" }
  ],
  "item": [
