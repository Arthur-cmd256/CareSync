            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": 1,\n  \"profissionalId\": 1,\n  \"dataHora\": \"2026-09-20T10:00:00\",\n  \"observacoes\": \"Consulta de rotina\"\n}"
            }
          }
        },
        {
          "name": "Editar consulta (PATCH - cancelar)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/consultas/1", "host": ["{{base_url}}"], "path": ["consultas", "1"] },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "medico1" },
                { "key": "password", "value": "123456" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELADA\"\n}"
            }
          }
        }
