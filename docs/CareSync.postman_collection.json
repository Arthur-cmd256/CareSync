      "item": [
        {
          "name": "Listar consultas (todas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/consultas", "host": ["{{base_url}}"], "path": ["consultas"] },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "medico1" },
                { "key": "password", "value": "123456" }
              ]
            }
          }
        },
        {
          "name": "Criar consulta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
