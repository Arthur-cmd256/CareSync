              "type": "basic",
              "basic": [
                { "key": "username", "value": "medico1" },
                { "key": "password", "value": "123456" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { consultasPorPaciente(pacienteId: 1) { id pacienteNome profissionalNome dataHora status observacoes } }\"\n}"
