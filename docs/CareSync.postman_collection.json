    {
      "name": "4. GraphQL",
      "item": [
        {
          "name": "Medico - historico de qualquer paciente (OK)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/graphql", "host": ["{{base_url}}"], "path": ["graphql"] },
